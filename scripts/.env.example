# Devnet first! Use a Helius / Triton RPC for mainnet.
RPC_URL=https://api.devnet.solana.com

# Keypairs: base58 secret OR path to a Solana CLI .json file
ADMIN_KEYPAIR=~/.config/solana/id.json
FEE_SPLITTER_KEYPAIR=./keys/fee-splitter.json

# Wallet addresses
FEE_SPLITTER_WALLET=
# Defaults to the treasury address in src/platform.ts
TEAM_WALLET=
HOLDER_POT_WALLET=
# Defaults to GCHZXtrG8dF8n7KNgcxWGR4QpCBhf71ZBgrQDeKroUi6 (src/platform.ts)
TREASURY_WALLET=
LEVERAGE_VAULT_PDA=
HOLDER_POT_KEYPAIR=./keys/holder-pot.json
# Comma-separated wallets that never earn holder rewards (treasury, team...)
REWARD_EXCLUDED=
